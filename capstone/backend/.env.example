PORT=5000
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=ecommerce_db

# Online hosting: use this instead of the PG* lines
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# CORS_ORIGIN=https://your-frontend.example.com

# true = send the database activity to the browser panel (good for demos).
# false = keep database details out of every response (use this when deployed).
DEMO_MODE=true
